<Window x:Class="ComputerMonitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComputerMonitoring"
        mc:Ignorable="d"
        Title="Monitor" Height="40" Width="540"
        WindowStyle = "None" AllowsTransparency = "True" Background = "White" Opacity = "0.4" Topmost = "True">

    <Grid>
        <StackPanel Orientation = "Horizontal" Margin = "10" Background="Transparent">
            <TextBlock x:Name="CpuText" FontSize="14" Foreground="#0077DD" Margin = "0, 0, 10, 0"/>
            <TextBlock x:Name="NvidiaText" FontSize="14" Foreground="#0077DD" Margin = "0, 0, 10, 0"/>
            <TextBlock x:Name="AmdText" FontSize="14" Foreground="#0077DD" Margin = "0, 0, 10, 0"/>
            <TextBlock x:Name="RamText" FontSize="14" Foreground="#0077DD" Margin="0, 0, 10, 0"/>
            <TextBlock x:Name="BatteryText" FontSize="14" Foreground="#0077DD" Margin="0, 0, 10, 0"/>
            <TextBlock x:Name="TimeText" FontSize="14" Foreground="#0077DD"/>
        </StackPanel>
    </Grid>
</Window>